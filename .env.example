# n3rve environment configuration
# Copy this file to .env and adjust values as needed

# Per-stage time budget in minutes (default: 120)
HANDSHAKE_MAX_STAGE_MIN=120

# EAPOL pairing timeout in seconds (default: 2)
HANDSHAKE_EAPOL_TIMEOUT=2

# Skip all automatic package-manager installs (set to "1" to disable)
HANDSHAKE_NO_AUTOINSTALL=

# Enable deep pass: attack each unsolved network individually
HANDSHAKE_DEEP=
